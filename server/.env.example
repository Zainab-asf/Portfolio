# Server .env — copy this to server/.env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Port
PORT=5000

# Email config (for contact form — use Gmail App Password)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_TO=your.email@gmail.com

# Node environment
NODE_ENV=development

# ── Admin dashboard auth ────────────────────────────────────────────────
# Long random string used to sign admin login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Your admin username (not an email, just a login name)
ADMIN_USERNAME=admin

# bcrypt hash of your admin password — NEVER put the plaintext password here.
# Generate with: npm run hash-password -- "your-new-password"   (run from server/)
ADMIN_PASSWORD_HASH=replace_with_output_of_hash-password_script
