# Copy this file to server/.env and fill in your values

# MongoDB (optional — contact form works email-only without it)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio

# Email (Nodemailer — Gmail app password recommended)
EMAIL_USER=zainab.asif.dev@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_TO=zainab.asif.dev@gmail.com

# Environment
NODE_ENV=production
PORT=5000

# ── Admin dashboard auth (see server/.env.example for full notes) ──────
JWT_SECRET=replace_with_a_long_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_output_of_hash-password_script
